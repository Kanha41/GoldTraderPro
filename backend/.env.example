# ================================================
# GoldTrader Pro - Backend Environment Variables
# Copy this file as .env and fill in your values
# DO NOT commit .env to GitHub
# ================================================

# PostgreSQL Database (Get from Neon.tech)
DATABASE_URL=postgresql://neondb_owner:password@ep-host.region.neon.tech/goldtrader?sslmode=require

# JWT Secret - Use any long random string for security
JWT_SECRET=your-super-secure-random-jwt-secret-key

# Server Port (Render uses 10000 by default)
PORT=10000

# Node Environment
NODE_ENV=production

# Frontend URL for CORS (Your Render Static Site URL)
FRONTEND_URL=https://goldtrader-frontend.onrender.com

# === OPTIONAL: Email OTP (for Forgot Password via email) ===
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# === OPTIONAL: Twilio SMS OTP (for signup verification) ===
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=+1234567890

# === OPTIONAL: Razorpay Payments ===
RAZORPAY_KEY_ID=rzp_live_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
